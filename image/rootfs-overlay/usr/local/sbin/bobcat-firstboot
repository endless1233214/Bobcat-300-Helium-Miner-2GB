#!/bin/sh
set -eu

mkdir -p /var/lib/bobcat-miner /etc/bobcat-miner
WEBUI_SETUP_MARKER=/etc/bobcat-miner/webui-first-run-setup

if [ ! -s /etc/machine-id ]; then
    systemd-machine-id-setup >/dev/null 2>&1 || true
fi

if ! getent passwd bobcat >/dev/null 2>&1; then
    useradd -m -s /bin/bash bobcat
    passwd -l bobcat >/dev/null 2>&1 || true
fi

if [ -s /etc/bobcat-miner/authorized_keys ]; then
    install -d -m 700 -o bobcat -g bobcat /home/bobcat/.ssh
    install -m 600 -o bobcat -g bobcat /etc/bobcat-miner/authorized_keys /home/bobcat/.ssh/authorized_keys
fi

if getent group sudo >/dev/null 2>&1; then
    usermod -aG sudo bobcat >/dev/null 2>&1 || true
fi
install -d -m 755 /etc/sudoers.d
{
    echo "bobcat ALL=(ALL) NOPASSWD:ALL"
} > /etc/sudoers.d/90-bobcat-admin
chmod 0440 /etc/sudoers.d/90-bobcat-admin

if [ ! -e "$WEBUI_SETUP_MARKER" ] && [ ! -s /etc/bobcat-miner/webui.env ]; then
    password="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(18))
PY
)"
    {
        echo "BOBCAT_WEBUI_USER=admin"
        echo "BOBCAT_WEBUI_PASSWORD=${password}"
    } > /etc/bobcat-miner/webui.env
    chmod 600 /etc/bobcat-miner/webui.env
fi

ssh-keygen -A >/dev/null 2>&1 || true
hostnamectl set-hostname bobcat300 >/dev/null 2>&1 || true

touch /var/lib/bobcat-miner/firstboot.done
