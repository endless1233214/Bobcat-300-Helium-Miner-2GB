#!/bin/sh
set -eu

CONFIG_DIR=/opt/bobcat-miner/pktfwd
RUN_DIR="${CONFIG_DIR}/run"

mkdir -p "$RUN_DIR"
/usr/bin/python3 /usr/local/lib/bobcat-miner/render-pktfwd-config.py

export CONCENTRATOR_RESET_PIN="${BOBCAT_RESET_GPIO:-149}"

if [ -x "${CONFIG_DIR}/reset_lgw.sh" ]; then
    cp "${CONFIG_DIR}/reset_lgw.sh" "${RUN_DIR}/reset_lgw.sh"
    chmod 0755 "${RUN_DIR}/reset_lgw.sh"
    "${RUN_DIR}/reset_lgw.sh" start || true
fi

cd "$RUN_DIR"
exec "${CONFIG_DIR}/lora_pkt_fwd"
