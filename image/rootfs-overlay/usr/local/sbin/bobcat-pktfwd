#!/bin/sh
set -eu

CONFIG_DIR=/opt/bobcat-miner/pktfwd
RUN_DIR="${CONFIG_DIR}/run"

mkdir -p "$RUN_DIR"
/usr/bin/python3 /usr/local/lib/bobcat-miner/render-pktfwd-config.py

if [ -x /opt/bobcat-miner/pktfwd/reset_lgw.sh ]; then
    CONCENTRATOR_RESET_PIN="${BOBCAT_RESET_GPIO:-149}" /opt/bobcat-miner/pktfwd/reset_lgw.sh start || true
fi

cd "$RUN_DIR"
exec /opt/bobcat-miner/pktfwd/lora_pkt_fwd

