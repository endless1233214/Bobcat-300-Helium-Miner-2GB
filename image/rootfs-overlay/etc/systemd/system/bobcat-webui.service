[Unit]
Description=Bobcat local web UI
After=network-online.target bobcat-firstboot.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/bobcat-miner/config.env
EnvironmentFile=-/etc/bobcat-miner/webui.env
ExecStart=/usr/bin/python3 /usr/local/lib/bobcat-miner/webui.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

